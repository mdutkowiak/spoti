# ==============================================================================
# SPONTIFY / SELF-HOSTED MUSIC STACK - ENVIRONMENT CONFIGURATION
# ==============================================================================

# System User/Group ID dla wolumenów /music i /data (domyślnie 1000:1000)
PUID=1000
PGID=1000
TZ=Europe/Warsaw

# Ścieżki dyskowe na hoście (dostosuj do swojego serwera Debian, np. /opt/music-stack/music)
MUSIC_DIR=./music
DATA_DIR=./data

# ------------------------------------------------------------------------------
# NAVIDROME CONFIGURATION
# ------------------------------------------------------------------------------
NAVIDROME_PORT=4533
ND_SCANSCHEDULE=@every 1h
ND_LOGLEVEL=info
ND_SESSIONTIMEOUT=48h
ND_DEFAULTLANGUAGE=pl
ND_ENABLETRANSCODINGCONFIG=true
ND_TRANSCODINGCACHE_SIZE=5000MB
ND_IMAGECACHESIZE=1000MB

# Dane administracyjne Navidrome (używane przez Downloader API do wywoływania natychmiastowego startScan)
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PASSWORD=change_this_secure_admin_password

# ------------------------------------------------------------------------------
# MUSIC DOWNLOADER API CONFIGURATION
# ------------------------------------------------------------------------------
API_PORT=8000
API_SECRET_KEY=change_this_secret_token_for_api_auth

# Spotify Web API Credentials (pobierz bezpłatnie z developer.spotify.com)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Domyślny format audio: opus (rekomendowany, ~160kbps), mp3 (320kbps), flac
DEFAULT_AUDIO_FORMAT=opus
AUDIO_BITRATE=160k

# Integracja FLAC (Opcjonalnie: SLSKD - Soulseek Daemon)
ENABLE_SLSKD=false
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=your_slskd_api_key

# Integracja powiadomień Webhook / Telegram (opcjonalne)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# DOMAIN & REVERSE PROXY
# ------------------------------------------------------------------------------
DOMAIN_NAME=spoti.daqu.eu
ACME_EMAIL=admin@daqu.eu
